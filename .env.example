# Better Auth
# NUXT_BETTER_AUTH_SECRET overrides runtimeConfig.betterAuthSecret at runtime.
# Required in production - generate a long random string, e.g.:
#   openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# NUXT_PUBLIC_BETTER_AUTH_URL overrides runtimeConfig.public.betterAuthUrl.
NUXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Database (SQLite file path)
# NUXT_DB_FILE_PATH overrides runtimeConfig.dbFilePath. The containing
# directory is created automatically if it does not exist yet.
NUXT_DB_FILE_PATH=./data/app.db

# AI Deck Assistant (Phase 5) / KI-Deck-Assistent
# Works with any OpenAI-compatible Chat Completions endpoint, e.g. OpenAI,
# OpenRouter, Ollama, LM Studio, or OpenCode Zen.
# NUXT_ASSISTANT_PROVIDER selects the backing model: '' (auto-detect from the
# API key or a custom base URL), 'openai', or 'fake' (deterministic, no
# network — useful for local dev and E2E tests). Leave empty and set an API
# key (or a custom base URL for a keyless local server) to enable it.
NUXT_ASSISTANT_PROVIDER=
# NUXT_ASSISTANT_BASE_URL overrides runtimeConfig.assistant.baseUrl
# (default: https://api.openai.com/v1). Point this at another
# OpenAI-compatible endpoint, e.g. https://openrouter.ai/api/v1 or
# http://localhost:11434/v1 for Ollama.
NUXT_ASSISTANT_BASE_URL=
# NUXT_ASSISTANT_API_KEY overrides runtimeConfig.assistant.apiKey. If left
# empty, it falls back to the OPENAI_API_KEY env var; leave both empty for a
# keyless local server (Ollama, LM Studio).
NUXT_ASSISTANT_API_KEY=
# NUXT_ASSISTANT_MODEL overrides the model id (default: gpt-4o-mini).
NUXT_ASSISTANT_MODEL=
# NUXT_ASSISTANT_REASONING_EFFORT is sent as `reasoning_effort` when set
# (low | medium | high). Some gateways (e.g. OpenCode Go) require it for
# certain models; leave empty otherwise.
NUXT_ASSISTANT_REASONING_EFFORT=
# NUXT_ASSISTANT_VISION_MODEL overrides the model used for a chat turn that
# contains an image (Phase 8's chat assistant, /assistent). Leave empty to
# use NUXT_ASSISTANT_MODEL for image turns too; set this only if your
# provider's default model isn't the (best) vision-capable one it offers.
NUXT_ASSISTANT_VISION_MODEL=
#
# Example: OpenCode Go subscription (not pay-per-use Zen, which is /zen/v1);
# https://opencode.ai/zen/go/v1/models lists the available models. Go
# requires an `x-opencode-session` header on every request; the app sends
# it automatically (see docs/adr/0010-chat-assistant-with-tools.md), no
# extra configuration needed here.
#   NUXT_ASSISTANT_PROVIDER=openai
#   NUXT_ASSISTANT_BASE_URL=https://opencode.ai/zen/go/v1
#   NUXT_ASSISTANT_API_KEY=<your key>
#   NUXT_ASSISTANT_MODEL=glm-5.3-flash
#   NUXT_ASSISTANT_REASONING_EFFORT=low
